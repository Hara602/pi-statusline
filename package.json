{
	"name": "pi-statusline",
	"version": "0.2.1",
	"description": "A Codex-style status line (footer) for the Pi coding agent: session, cwd, model, reasoning, run state and version",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package",
		"pi-extension",
		"statusline",
		"footer",
		"tui",
		"codex"
	],
	"license": "MIT",
	"pi": {
		"extensions": ["./extensions/index.ts"]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "node scripts/check.mjs"
	},
	"devDependencies": {
		"typescript": "^5.9.0"
	}
}
